# ─── Meal Planner — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# ── Auth ────────────────────────────────────────────────────────────────────
# Fallback-only password gate, used ONLY when Supabase is NOT configured
# below (e.g. local dev without a Supabase project). When Supabase IS
# configured, the real gate is Supabase Auth (email+password) — see AuthGate.
# Leave empty (or remove entirely) for open access during local development.
VITE_APP_PASSWORD=

# ── Supabase (shared sync + Auth) ────────────────────────────────────────────
# Create a free project at https://supabase.com
# Data sync (storage.js) AND login (AuthGate.jsx) both use this project.
# Create the household's user accounts by hand in the Supabase dashboard:
# Authentication → Users → Add user (check "Auto Confirm User").
# VITE_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
