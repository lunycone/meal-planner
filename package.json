{
  "name": "meal-planner",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:portions": "esbuild scripts/check-smart-portions.mjs --bundle --platform=node --format=cjs --packages=external --jsx=automatic --define:import.meta.env={} --outfile=node_modules/.cache/meal-planner/check-portions.cjs && node node_modules/.cache/meal-planner/check-portions.cjs",
    "check:storage": "esbuild scripts/check-storage.mjs --bundle --platform=node --format=cjs --packages=external --jsx=automatic --define:import.meta.env={} --outfile=node_modules/.cache/meal-planner/check-storage.cjs && node node_modules/.cache/meal-planner/check-storage.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
